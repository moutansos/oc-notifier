{
  "name": "oc-notifier",
  "version": "0.1.0",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "install-claude-plugin": "bun run src/index.ts --install-claude-plugin",
    "install-grok-plugin": "bun run src/index.ts --install-grok-plugin",
    "install-codex-plugin": "bun run src/index.ts --install-codex-plugin",
    "install-copilot-plugin": "bun run src/index.ts --install-copilot-plugin"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
